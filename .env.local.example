# =============================================================================
# Sri Dhanam Motors - Supabase Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project credentials.
# =============================================================================

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-only secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Application Settings
SDM_SECRET_KEY=sdm-motors-secure-key-2026
SDM_DEFAULT_EMAIL=admin@sridhanammotors.com

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.py",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/"
        }
      ]
    },
    {
      "src": "/(?<path>.+)",
      "dest": "/api/index.py",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$path"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{sdm_billing/**,public/**,static/**}",
      "maxDuration": 30
    }
  }
}

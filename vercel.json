{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{sdm_billing/**,public/**,static/**}",
      "maxDuration": 30
    }
  }
}

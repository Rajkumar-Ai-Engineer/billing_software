{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "sdm_billing/**",
          "public/**",
          "static/**",
          "data/**"
        ]
      }
    }
  ],
  "functions": {
    "main.py": {
      "includeFiles": "sdm_billing/**",
      "maxDuration": 30
    },
    "api/index.py": {
      "includeFiles": "sdm_billing/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
